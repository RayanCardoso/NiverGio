# Copie este arquivo para ".env" (mesma pasta) e preencha com os dados reais
# do banco criado no cPanel da HostGator (MySQL Databases). O ".env" NÃO deve
# ser commitado (já está no .gitignore).

DB_HOST=localhost
DB_NAME=cpaneluser_nivergio
DB_USER=cpaneluser_nivergio
DB_PASS=REPLACE_ME

# senha usada para acessar a página /admin (lista de confirmações)
ADMIN_PASSWORD=REPLACE_ME

# Opcional: porta do MySQL (padrão 3306). Só costuma ser necessária localmente.
# DB_PORT=3306
